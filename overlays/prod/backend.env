# Backend configuration for prod.
#
# In a file rather than `literals:` in kustomization.yaml because CI runs
# `kustomize edit set image` on every deploy, and that rewrite hoists any comment
# out of the literals list up to the node above it. Nothing rewrites this file, so
# what is written beside a value stays beside it.

# Per-environment bucket, so staging can never write into the prod one.
MC_MINIO_BUCKET=music-collector-photos-prod

MC_ENVIRONMENT=prod
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod

# The app's own origin. OAuth redirect URIs are built from it and must match what
# the provider has registered, and password-reset links point at it -- the
# application.yml default is localhost, which would silently break both.
MC_PUBLIC_URL=https://rekordo.de

# Hosts a shipped phone build still starts an external sign-in on. The provider has to call
# back to the host that set the state cookie, so these get their own registered redirect
# URI rather than MC_PUBLIC_URL's. Every entry must be registered with Google and Apple.
# The origin of MC_PUBLIC_URL is always allowed without being listed here, which is why
# rekordo.de itself is absent.
MC_OAUTH_CALLBACK_ORIGINS=https://rekordo.jannekeipert.de,https://music.jannekeipert.de

MC_PUSH_ENABLED=true

# Deliberately observing, not refusing. Every phone build at v1.23.0 or earlier predates
# the widget and sends no token; enforcing before those are gone would lock their owners
# out of their own accounts. The widget is drawn and its tokens are verified and logged
# meanwhile. Flip to true once `Turnstile would have refused ...: no token` has died away
# in the backend log and the new app build has rolled out.
MC_TURNSTILE_ENFORCE=false

# Every host the widget can be solved on here: rekordo.de, and the old host that shipped
# phone builds still load /turnstile.html from.
MC_TURNSTILE_HOSTNAMES=rekordo.de,rekordo.jannekeipert.de
