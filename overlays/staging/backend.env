# Backend configuration for staging.
#
# In a file rather than `literals:` in kustomization.yaml because CI runs
# `kustomize edit set image` on every deploy, and that rewrite hoists any comment
# out of the literals list up to the node above it. Three explanations drifted
# away from the values they described that way -- see commit 3603677, which moved
# one in the same commit as an image bump. Nothing rewrites this file, so what is
# written beside a value stays beside it.

# Per-environment bucket, so staging can never write into the prod one.
MC_MINIO_BUCKET=music-collector-photos-staging

MC_ENVIRONMENT=staging
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=staging

# The app's own origin. OAuth redirect URIs are built from it and must match what
# the provider has registered, and password-reset links point at it -- the
# application.yml default is localhost, which would silently break both.
MC_PUBLIC_URL=https://staging.rekordo.de

# Hosts a phone build may still start an external sign-in on; see the prod overlay.
# The origin of MC_PUBLIC_URL is always allowed without being listed here, so
# staging.rekordo.de is absent on purpose rather than by omission.
MC_OAUTH_CALLBACK_ORIGINS=https://rekordo-staging.jannekeipert.de,https://music-staging.jannekeipert.de

# Staging refuses outright from the start. No shipped phone build is signed into it, so
# there is nothing to wait for -- and it is the only place the action and hostname
# checks can be exercised against real keys before prod comes to rely on them.
MC_TURNSTILE_ENFORCE=true

# Every host the widget can be solved on here. Unlike the OAuth origins above, this
# check has no implicit entry, so the public host is listed explicitly.
MC_TURNSTILE_HOSTNAMES=staging.rekordo.de,rekordo-staging.jannekeipert.de
