    {
      "id": 14,
      "type": "timeseries",
      "title": "Sync records dropped / min, by kind and reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
