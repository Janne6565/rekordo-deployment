      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "editorMode": "code",
          "expr": "sum by (kind, reason) (rate(rekordo_sync_push_dropped_total{deployment_environment=\"$env\", job=\"rekordo-backend\"}[30m]) * 60)",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "{{kind}} / {{reason}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "description": "A dropped push is a record a phone tried to sync and the backend refused. Sustained non-zero means a client is stuck: it will retry the same poison record forever and that device silently stops syncing."
    },
